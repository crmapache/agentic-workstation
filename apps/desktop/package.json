{
  "name": "@agentic-workstation/desktop",
  "productName": "Agentic Workstation",
  "version": "0.1.2",
  "private": true,
  "author": "crmapache",
  "description": "Лёгкая IDE для macOS: проекты, файлы, редактор и GUI провайдеров LLM",
  "main": "./out/main/index.js",
  "agenticWorkstation": {
    "releasesRepo": "crmapache/agentic-workstation-releases"
  },
  "scripts": {
    "postinstall": "node scripts/install-electron.mjs",
    "dev": "pnpm --filter @agentic-workstation/browser-extension build && electron-vite dev --watch",
    "build": "pnpm --filter @agentic-workstation/browser-extension build && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "pnpm run build && AGENTIC_WORKSTATION_SIGN=required electron-builder --mac --arm64 --publish never",
    "dist:local": "pnpm run build && electron-builder --mac --arm64 --publish never",
    "dist:win": "pnpm run build && electron-builder --win --x64 --publish never",
    "cdp": "node scripts/cdp.mjs",
    "update:e2e": "bash scripts/update-e2e.sh"
  },
  "dependencies": {
    "koffi": "3.3.3",
    "node-pty": "1.2.0-beta.18",
    "semver": "7.8.5"
  },
  "devDependencies": {
    "@agentic-workstation/browser-protocol": "workspace:*",
    "@agentic-workstation/relay": "workspace:*",
    "@agentic-workstation/remote-protocol": "workspace:*",
    "@agentic-workstation/ui": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@tanstack/react-query": "5.104.3",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "@vitejs/plugin-react": "6.1.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "clsx": "2.1.1",
    "diff": "9.0.0",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "happy-dom": "21.0.3",
    "i18next": "26.4.6",
    "katex": "0.19.0",
    "lucide-react": "1.57.0",
    "marked": "18.1.1",
    "monaco-editor": "0.57.0",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.0.18",
    "sass": "1.105.2",
    "shiki": "4.5.0",
    "smooth-stream-text": "0.2.2",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  }
}
